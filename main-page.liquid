  assign ev_hook1_script  = 'What you need is'
  assign ev_hook1_b       = 'somewhere to point it.'
  assign ev_video_poster  = 'https://cdn.shopify.com/s/files/1/0754/9013/2214/files/DSC9036_2_JPG.jpg?v=1788016452'
