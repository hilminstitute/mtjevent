  # ---------- About the event ------------------------------------------
  assign ev_about_eyebrow = 'What is the summit?'
  assign ev_about_p1 = 'One full day built around a single question: what are you going to do with the next twelve months? Four tracks run from morning to evening, on work, service, learning and character, and every session ends with something you write down rather than something you applaud.'
  assign ev_about_p2 = 'Hilm Institute runs it because young people in Lahore are not short of ambition. They are short of a room where somebody older tells them the truth, and short of a plan small enough to start on Monday.'

  # ---------- Gallery one :: filename~alt --------------------------------
