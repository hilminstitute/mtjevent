  # ---------- Footer :: label~url ---------------------------------------
  assign ev_org        = 'HILM INSTITUTE'
  assign ev_rights     = 'All rights reserved.'
  assign ev_socials    = 'Instagram~https://instagram.com/|YouTube~https://youtube.com/|WhatsApp~https://wa.me/' | split: '|'

  # ---------- Imagery ----------------------------------------------------
